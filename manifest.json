{
  "manifest_version": 3,
  "name": "Eye Relief — 20-20-20 Green Overlay",
  "version": "1.0.0",
  "description": "Protects your eyes with the 20-20-20 rule by forcing a soothing green overlay every 20 minutes for a 20-second break.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Eye Relief (20-20-20)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
